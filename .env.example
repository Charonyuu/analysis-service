# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/analytics

# 驗證
DASHBOARD_SECRET=your-super-secret-token-change-this

# 允許的來源網域（逗號分隔，完全比對）
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,https://charonyu.vercel.app

# 允許的來源網域 pattern（逗號分隔，支援 * wildcard）
ALLOWED_ORIGIN_PATTERNS=https://*.app.charonyu.cc

# Port
PORT=3000

# 環境
NODE_ENV=development

# PTT Proxy（透過 Cloudflare Worker 中繼，繞過 PTT 對 datacenter IP 的封鎖）
# PTT_PROXY_WORKER_URL=https://ptt-proxy.<your-subdomain>.workers.dev/
# PTT_PROXY_SECRET=lumee_ptt_proxy_s3cret

# Notion OAuth（需在 https://www.notion.so/my-integrations 建立 OAuth app）
# NOTION_OAUTH_CLIENT_ID=<client-id>
# NOTION_OAUTH_CLIENT_SECRET=<client-secret>

# Notion 加密（AES-256-GCM，用 openssl rand -hex 32 產生）
NOTION_ENCRYPTION_KEY=<64-hex-chars>

# Redis（Notion 快取用，選填 — 未配置時使用 in-memory cache）
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# IAP shared secret（必須跟 iOS app AppURLs.iapSecret 一致）
IAP_SECRET=lumee_iap_s3cret_2026

# APNs 推播（拿不到 .p8 就先註解掉，server 啟動時不會載入）
# APNS_KEY_PATH=/Users/yourname/.apns/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=YOUR_TEAM_ID
# APNS_BUNDLE_ID=com.pixelframe.app
# APNS_PRODUCTION=false   # development=sandbox，archive 上架時改 true
